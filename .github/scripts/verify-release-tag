#!/usr/bin/env bash
set -euo pipefail

tag="${1:?tag is required}"
expected_image="${2:?expected image is required}"
expected_digest="${3:?expected digest is required}"

if [[ ! "${tag}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-bc\.[0-9]+$ ]]; then
  echo "BuildKit release tag must look like vX.Y.Z-bc.N, got ${tag}" >&2
  exit 1
fi

if [[ ! "${expected_digest}" =~ ^sha256:[a-f0-9]{64}$ ]]; then
  echo "BuildKit image digest must be immutable, got ${expected_digest}" >&2
  exit 1
fi

git fetch --force --tags origin "refs/tags/${tag}:refs/tags/${tag}"
if [[ "$(git cat-file -t "${tag}" 2>/dev/null || true)" != "tag" ]]; then
  echo "Release tag ${tag} must be an annotated signed tag object." >&2
  exit 1
fi

allowed_signers="${RUNNER_TEMP:-/tmp}/release_allowed_signers"
printf '%s\n' \
  'gaurav@gauravtiwari.co.uk ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILVC6w5HTvW0TZwuN0/J3axNnAfNclejNgpCWs0b2KAM' \
  'gaurav@gauravtiwari.co.uk ssh-rsa ' \
  > "${allowed_signers}"

git \
  -c gpg.format=ssh \
  -c gpg.ssh.allowedSignersFile="${allowed_signers}" \
  tag -v "${tag}"

tag_body="$(git cat-file tag "${tag}" | sed '/^-----BEGIN SSH SIGNATURE-----$/,$d')"
tag_image="$(printf '%s\n' "${tag_body}" | sed -n 's/^image: //p' | head -1)"
tag_digest="$(printf '%s\n' "${tag_body}" | sed -n 's/^image-digest: //p' | head -1)"

if [[ "${tag_image}" != "${expected_image}" ]]; then
  echo "Release tag ${tag} is signed for image ${tag_image:-<missing>}, not ${expected_image}." >&2
  exit 1
fi

if [[ "${tag_digest}" != "${expected_digest}" ]]; then
  echo "Release tag ${tag} is signed for digest ${tag_digest:-<missing>}, not ${expected_digest}." >&2
  exit 1
fi

echo "Verified signed release tag ${tag} binds ${expected_image} to ${expected_digest}."
